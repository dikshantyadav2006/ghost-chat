# URL of the GhostChat signaling server (Socket.IO).
# Local dev: http://localhost:4000
# Production: https://<your-render-service>.onrender.com
NEXT_PUBLIC_SIGNAL_URL=http://localhost:4000

# Cloudinary unsigned upload (used by the "Save to cloud" button on media messages).
# Create an unsigned upload preset in your Cloudinary console and allow it for unsigned uploads.
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# TURN relay for P2P file transfers (needed for symmetric NATs).
# Comma-separated URLs; optional username/credential for authenticated TURN.
# NEXT_PUBLIC_TURN_URLS=
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
