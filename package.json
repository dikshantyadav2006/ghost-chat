{
  "name": "ghostchat",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,mjs,cjs,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,mjs,cjs,css,md}\""
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "turbo": "^2.10.8",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
